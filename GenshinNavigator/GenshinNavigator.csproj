<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GenshinNavigator</AssemblyName>
    <RootNamespace>GenshinNavigator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.34" />
  </ItemGroup>
</Project>
