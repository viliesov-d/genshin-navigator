<Window x:Class="GenshinNavigator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування" Width="390" Height="330" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#FF171C26" Foreground="#FFF4F6F8">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Налаштування панелі" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Значення зберігаються на цьому комп’ютері." Foreground="#FF9AA4B2"
                 FontSize="11" Margin="0,5,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,22,0,0">
      <DockPanel><TextBlock Text="Прозорість" /><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" /></DockPanel>
      <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
              ValueChanged="OpacitySlider_ValueChanged" Margin="0,8,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <DockPanel><TextBlock Text="Розмір панелі" /><TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" /></DockPanel>
      <Slider x:Name="ScaleSlider" Minimum="80" Maximum="135" TickFrequency="5" IsSnapToTickEnabled="True"
              ValueChanged="ScaleSlider_ValueChanged" Margin="0,8,0,0" />
    </StackPanel>
    <CheckBox x:Name="LockPositionCheckBox" Grid.Row="3" Content="Зафіксувати положення панелі"
              VerticalAlignment="Top" Margin="0,20,0,0" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Скасувати" Width="92" Height="34" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="Зберегти" Width="92" Height="34" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
