<Window x:Class="GenshinNavigator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування" Width="430" Height="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#FF171C26" Foreground="#FFF4F6F8">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Налаштування панелі" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Значення зберігаються на цьому комп’ютері." Foreground="#FF9AA4B2"
                 FontSize="11" Margin="0,5,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,22,0,0">
      <DockPanel><TextBlock Text="Прозорість" /><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" /></DockPanel>
      <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
              ValueChanged="OpacitySlider_ValueChanged" Margin="0,8,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <DockPanel><TextBlock Text="Розмір панелі" /><TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" /></DockPanel>
      <Slider x:Name="ScaleSlider" Minimum="80" Maximum="135" TickFrequency="5" IsSnapToTickEnabled="True"
              ValueChanged="ScaleSlider_ValueChanged" Margin="0,8,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock Text="Скриншот карти для зіставлення" FontWeight="SemiBold" />
      <TextBlock Text="Оберіть скриншот відкритої карти гри. Він залишиться на цьому комп’ютері. Перемістіть панель так, щоб вона не закривала мінікарту."
                 Foreground="#FF9AA4B2" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
      <DockPanel>
        <Button Content="Обрати…" Width="84" Height="30" DockPanel.Dock="Right" Click="BrowseMap_Click" />
        <TextBox x:Name="MapPathTextBox" IsReadOnly="True" VerticalContentAlignment="Center"
                 Background="#FF222936" Foreground="#FFF4F6F8" BorderBrush="#FF424B5A"
                 Padding="6,3" />
      </DockPanel>
    </StackPanel>
    <CheckBox x:Name="LockPositionCheckBox" Grid.Row="4" Content="Зафіксувати положення панелі"
              VerticalAlignment="Top" Margin="0,16,0,0" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Скасувати" Width="92" Height="34" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="Зберегти" Width="92" Height="34" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
