<Window x:Class="GenshinNavigator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Genshin Navigator"
        Width="352" Height="204"
        MinWidth="320" MinHeight="190"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded" LocationChanged="Window_LocationChanged" Closed="Window_Closed">
  <Border x:Name="Card" Margin="5" Padding="14" CornerRadius="16"
          Background="{StaticResource PanelBrush}" BorderBrush="#55FFFFFF" BorderThickness="1"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="GameProcessDot" Width="8" Height="8" Fill="#FF687381" Margin="0,0,8,0" />
          <TextBlock Text="GENSHIN NAVIGATOR" Foreground="#FFF4F6F8" FontSize="11"
                     FontWeight="Bold" />
          <TextBlock Text="  ·  ЕТАП 1/6" Foreground="{StaticResource MutedBrush}" FontSize="9"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="⚙" ToolTip="Налаштування" Style="{StaticResource IconButton}"
                  Click="Settings_Click" />
          <Button Content="×" ToolTip="Згорнути панель" Style="{StaticResource IconButton}"
                  Click="Hide_Click" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,13,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="54" Height="54" CornerRadius="16" Background="#20E8B45E"
                BorderBrush="#44E8B45E" BorderThickness="1" VerticalAlignment="Top">
          <TextBlock Text="➤" Foreground="#FF87909B" FontSize="25" HorizontalAlignment="Center"
                     VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform><RotateTransform Angle="-45" /></TextBlock.RenderTransform>
          </TextBlock>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="GameStatus" Text="Перевірка гри…" Foreground="#FFF4F6F8"
                     FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PositionStatus" Text="Позицію ще не визначено" Foreground="{StaticResource MutedBrush}"
                     FontSize="11" Margin="0,4,0,0" />
          <TextBlock x:Name="PositionDetailStatus" Text="Оберіть скриншот карти в налаштуваннях, щоб перевірити зіставлення"
                     Foreground="#FF7F8996" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="RegionStatus" Text="Маркерна база ще не підключена" Foreground="#FF99A3B0"
                   FontSize="10" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="‹" IsEnabled="False" ToolTip="Попередня ціль"
                Style="{StaticResource NavButton}" />
        <Button Grid.Column="2" Content="›" IsEnabled="False" ToolTip="Наступна ціль"
                Style="{StaticResource NavButton}" />
      </Grid>
    </Grid>
  </Border>
</Window>
