<Application x:Class="GenshinNavigator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#E8B45E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#E8171C26" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA4B2" />
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="3,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#FFCBD2DC" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#22FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#FF9AA4B2" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="#20FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Application.Resources>
</Application>
